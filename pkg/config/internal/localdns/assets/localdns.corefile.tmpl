# This Corefile follows the AKS AgentBaker LocalDNS policy with adaptations for
# the Unbounded nspawn runtime:
# - Node DNS forwards to resolver addresses discovered from the physical host
#   instead of assuming the Azure platform DNS address.
# - The metrics endpoint binds a runtime-resolved node address instead of :9253.
# - The AgentBaker critical-FQDN hosts file is omitted because Unbounded does not
#   run the AKS hosts-file refresher.
# Listener, upstream, cluster DNS, and metrics placeholders are resolved by
# Unbounded after AKS Flex Node renders the profile-specific server blocks.
health-check.localdns.local:53 {
    bind {{.NodeListener}} {{.ClusterListener}}
    whoami
}

{{range .Blocks}}{{.Zone}}:53 {
    {{if .LogQueries}}log{{else}}errors{{end}}
    bind {{.Listener}}
    forward . {{.Upstream}} {
        {{if .ForceTCP}}force_tcp
        {{end}}policy {{.ForwardPolicy}}
        max_concurrent {{.MaxConcurrent}}
    }
    ready {{.Listener}}:8181
    cache {{.CacheDuration}} {
        success 9984
        denial 9984
        {{if .ServeStale}}serve_stale {{.ServeStaleDuration}}s {{.ServeStalePolicy}}
        {{end}}servfail 0
    }
    loop
    nsid {{.NSID}}
    prometheus {{$.MetricsAddress}}
{{if .IsRootDomain}}    template ANY ANY internal.cloudapp.net {
        match "^(?:[^.]+\.){4,}internal\.cloudapp\.net\.$"
        rcode NXDOMAIN
        fallthrough
    }
    template ANY ANY reddog.microsoft.com {
        rcode NXDOMAIN
    }
{{end}}}

{{end}}