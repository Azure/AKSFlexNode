[Unit]
Description=AKS Flex Node Agent
After=network-online.target systemd-udev-settle.service{{range .Dependencies}} {{.}}{{end}}
Wants=network-online.target systemd-udev-settle.service{{if not (or .NoneIsolation .ContainerIsolation)}} machines.target{{end}}{{range .Dependencies}} {{.}}{{end}}
{{if .NoneIsolation}}# Node isolation: none
{{end}}{{if .ContainerIsolation}}# Node isolation: container
{{end}}OnFailure=aks-flex-node-agent-recovery.service
# Trigger last-good recovery after the upgraded daemon repeatedly fails.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
RemainAfterExit=no
ExecStart={{.CurrentBinaryPath}} agent --config /etc/aks-flex-node/config.json
TimeoutStartSec=300
TimeoutStopSec=60
# Restart configuration for daemon resilience
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
