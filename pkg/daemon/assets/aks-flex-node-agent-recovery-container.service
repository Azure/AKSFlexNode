[Unit]
Description=Recover AKS Flex Node Agent to its last-known-good image
# Only once an AgentUpgrade has selected an image: an ordinary failure of the
# agent's unit changes nothing, as on a host.
ConditionPathExists=/etc/aks-flex-node/agent-upgrade-signal.json
ConditionPathExists=/etc/aks-flex-node/agent-image.env

[Service]
Type=oneshot
Environment=AKS_FLEX_NODE_PULL_ARGS= AKS_FLEX_NODE_SNAPSHOTTER_PULL_ARGS= AKS_FLEX_NODE_SNAPSHOTTER_RUN_ARGS=
EnvironmentFile=/etc/sysconfig/aks-flex-node-container
EnvironmentFile=/etc/aks-flex-node/agent-image.env
# Only with a last good image to run: a selection that bootstrap's inputs wrote
# names none, until an upgrade switches. Skipped, the unit doesn't fail.
ExecCondition=/bin/sh -c 'test -n "$${AKS_FLEX_NODE_LAST_GOOD_IMAGE}"'
# containerd.service reports started before containerd answers.
ExecStartPre=/bin/sh -c 'until /usr/bin/ctr version >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=-/usr/bin/ctr --namespace aks-flex task delete --force aks-flex-node-recovery
ExecStartPre=-/usr/bin/ctr --namespace aks-flex container delete aks-flex-node-recovery
# Runs the last-good image's agent, which restores that image and restarts the
# agent's unit.
ExecStart=/usr/bin/ctr --namespace aks-flex run --rm $AKS_FLEX_NODE_SNAPSHOTTER_RUN_ARGS \
  --runc-systemd-cgroup --cgroup system-aksflex.slice:aks-flex:recovery \
  --privileged --net-host --with-ns pid:/proc/1/ns/pid \
  --mount type=bind,src=/,dst=/host,options=rbind:rslave \
  --env=AKS_FLEX_NODE_IMAGE=${AKS_FLEX_NODE_LAST_GOOD_IMAGE} \
  ${AKS_FLEX_NODE_LAST_GOOD_IMAGE} aks-flex-node-recovery \
  flex-agent-entrypoint aks-flex-node recover-agent-upgrade \
  --message "upgraded daemon failed repeatedly; restored the last-good image"
TimeoutStartSec=10min
