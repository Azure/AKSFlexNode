[Unit]
Description=AKS Flex YurtHub
Documentation=https://openyurt.io/docs/
# Provisioning stages this unit only. Activation downloads and installs the
# binary and writes the configuration below before enabling it.
ConditionPathExists=/etc/aks-flex-node/yurthub.env
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/aks-flex-node/yurthub.env
ExecStart=/usr/local/bin/aks-flex-yurthub --root-dir=/var/lib/yurthub --disk-cache-path=/var/lib/yurthub/cache $YURTHUB_ARGS
Restart=always
RestartSec=5s
UMask=0077

[Install]
WantedBy=multi-user.target
