{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operator": {
      "type": "object",
      "properties": {
        "imageRegistry": {"type": "string", "minLength": 1},
        "image": {"type": "string", "pattern": "^([^/]+:[^/]+)?$"},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent"]},
        "apiServerEndpoint": {"type": "string"},
        "reapLegacyResources": {"type": "boolean"},
        "resources": {"type": "object"}
      },
      "required": ["imageRegistry"]
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "nodeCidrs", "podCidrs"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "nodeCidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "podCidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "nodeBlockSize": {"type": "integer", "minimum": 16, "maximum": 30},
          "tunnelProtocol": {"type": "string"}
        }
      }
    },
    "sitePeering": {"type": "object"},
    "siteJob": {"type": "object"},
    "Azure": {"type": "object"}
  }
}
