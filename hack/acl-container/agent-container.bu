# Butane config that runs the AKS Flex Node agent as a privileged containerd
# container on Azure Container Linux. Prototype; see DESIGN.md next to it.
#
# Render it with Butane, from a directory holding the file it names:
#
#   butane --strict --files-dir . agent-container.bu > agent.ign
#
#   agent-container.env  AKS_FLEX_NODE_IMAGE, the agent image reference, and
#                        optionally AKS_FLEX_NODE_PULL_ARGS, extra flags for
#                        `ctr image pull`, such as --plain-http for a registry
#                        without TLS
#
# The container joins the host's network and PID namespaces and gets the host's
# root at /host, so it has the host's systemd, machinectl, and nspawn machines,
# but its own root filesystem.
variant: flatcar
version: 1.1.0
storage:
  files:
    - path: /etc/aks-flex-node/agent-container.env
      mode: 0644
      overwrite: true
      contents:
        local: agent-container.env
systemd:
  units:
    - name: aks-flex-node-container.service
      enabled: true
      contents: |
        [Unit]
        Description=AKS Flex Node agent container
        Wants=network-online.target
        After=network-online.target containerd.service
        Requires=containerd.service

        [Service]
        EnvironmentFile=/etc/aks-flex-node/agent-container.env
        # containerd.service reports started before containerd answers.
        ExecStartPre=/bin/sh -c 'until /usr/bin/ctr version >/dev/null 2>&1; do sleep 1; done'
        # The task and container outlive ctr if it is killed, so clear them.
        ExecStartPre=-/usr/bin/ctr --namespace aks-flex task kill --signal SIGKILL aks-flex-node
        ExecStartPre=-/usr/bin/ctr --namespace aks-flex container delete aks-flex-node
        # The progress bars go nowhere; errors still reach the journal.
        ExecStartPre=/bin/sh -c 'exec /usr/bin/ctr --namespace aks-flex image pull $$AKS_FLEX_NODE_PULL_ARGS "$$AKS_FLEX_NODE_IMAGE" >/dev/null'
        ExecStart=/usr/bin/ctr --namespace aks-flex run --rm \
          --privileged --net-host --with-ns pid:/proc/1/ns/pid \
          --mount type=bind,src=/,dst=/host,options=rbind:rslave \
          ${AKS_FLEX_NODE_IMAGE} aks-flex-node
        ExecStop=/usr/bin/ctr --namespace aks-flex task kill --signal SIGTERM aks-flex-node
        Restart=always
        RestartSec=5s
        TimeoutStartSec=15min

        [Install]
        WantedBy=multi-user.target
