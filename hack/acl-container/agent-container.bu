# Butane config that runs the AKS Flex Node agent as a privileged containerd
# container on Azure Container Linux. Prototype; see DESIGN.md next to it.
#
# Render it with Butane, from a directory holding the file it names:
#
#   butane --strict --files-dir . agent-container.bu > agent.ign
#
#   agent-container.env  AKS_FLEX_NODE_IMAGE, the agent image reference, and
#                        optionally AKS_FLEX_NODE_PULL_ARGS, extra flags for
#                        `ctr image pull`, such as --plain-http for a registry
#                        without TLS
#
# AKS_FLEX_NODE_SNAPSHOTTER_PULL_ARGS and AKS_FLEX_NODE_SNAPSHOTTER_RUN_ARGS,
# unset by default, pass a snapshotter to `ctr image pull` and `ctr run`;
# selinux-workaround.bu sets them.
#
# The container joins the host's network and PID namespaces and gets the host's
# root at /host, so it has the host's systemd, machinectl, and nspawn machines,
# but its own root filesystem. The host paths the agent writes are also mounted
# at their own paths, so the agent, unchanged, writes the host's.
variant: flatcar
version: 1.1.0
storage:
  directories:
    - path: /etc/aks-flex-node
      mode: 0755
    - path: /etc/unbounded
      mode: 0755
    - path: /var/lib/unbounded
      mode: 0755
    - path: /var/log/aks-flex-node
      mode: 0755
    - path: /var/lib/aks-flex-node/usr-local/upper
      mode: 0755
    - path: /var/lib/aks-flex-node/usr-local/work
      mode: 0755
  files:
    # Not in /etc/aks-flex-node: the agent's reset removes what's in it.
    - path: /etc/sysconfig/aks-flex-node-container
      mode: 0644
      overwrite: true
      contents:
        local: agent-container.env
systemd:
  units:
    # The agent installs its host helpers under /usr/local, as on main, and
    # host systemd runs them, such as the nspawn lifecycle helper at every
    # machine start. ACL's /usr, and /usr/local with it, is read-only, so an
    # overlay gives /usr/local a writable layer in /var.
    - name: usr-local.mount
      enabled: true
      contents: |
        [Unit]
        Description=Writable /usr/local for the AKS Flex Node agent
        Before=aks-flex-node-container.service

        [Mount]
        What=overlay
        Where=/usr/local
        Type=overlay
        Options=lowerdir=/usr/local,upperdir=/var/lib/aks-flex-node/usr-local/upper,workdir=/var/lib/aks-flex-node/usr-local/work

        [Install]
        WantedBy=local-fs.target
    - name: aks-flex-node-container.service
      enabled: true
      contents: |
        [Unit]
        Description=AKS Flex Node agent container
        Wants=network-online.target
        After=network-online.target containerd.service usr-local.mount
        Requires=containerd.service usr-local.mount

        [Service]
        EnvironmentFile=/etc/sysconfig/aks-flex-node-container
        # containerd.service reports started before containerd answers.
        ExecStartPre=/bin/sh -c 'until /usr/bin/ctr version >/dev/null 2>&1; do sleep 1; done'
        # The task and container outlive ctr if it is killed, so clear them.
        ExecStartPre=-/usr/bin/ctr --namespace aks-flex task kill --signal SIGKILL aks-flex-node
        ExecStartPre=-/usr/bin/ctr --namespace aks-flex container delete aks-flex-node
        # The progress bars go nowhere; errors still reach the journal.
        ExecStartPre=/bin/sh -c 'exec /usr/bin/ctr --namespace aks-flex image pull $$AKS_FLEX_NODE_SNAPSHOTTER_PULL_ARGS $$AKS_FLEX_NODE_PULL_ARGS "$$AKS_FLEX_NODE_IMAGE" >/dev/null'
        ExecStart=/usr/bin/ctr --namespace aks-flex run --rm $AKS_FLEX_NODE_SNAPSHOTTER_RUN_ARGS \
          --privileged --net-host --with-ns pid:/proc/1/ns/pid \
          --mount type=bind,src=/,dst=/host,options=rbind:rslave \
          --mount type=bind,src=/etc/os-release,dst=/etc/os-release,options=rbind:ro \
          --mount type=bind,src=/etc/systemd,dst=/etc/systemd,options=rbind:rslave \
          --mount type=bind,src=/etc/sysctl.d,dst=/etc/sysctl.d,options=rbind:rslave \
          --mount type=bind,src=/etc/modules-load.d,dst=/etc/modules-load.d,options=rbind:rslave \
          --mount type=bind,src=/etc/aks-flex-node,dst=/etc/aks-flex-node,options=rbind:rslave \
          --mount type=bind,src=/etc/unbounded,dst=/etc/unbounded,options=rbind:rslave \
          --mount type=bind,src=/var/lib/machines,dst=/var/lib/machines,options=rbind:rslave \
          --mount type=bind,src=/var/lib/unbounded,dst=/var/lib/unbounded,options=rbind:rslave \
          --mount type=bind,src=/var/log/aks-flex-node,dst=/var/log/aks-flex-node,options=rbind:rslave \
          --mount type=bind,src=/run,dst=/run,options=rbind:rslave \
          --mount type=bind,src=/usr/local,dst=/usr/local,options=rbind:rslave \
          ${AKS_FLEX_NODE_IMAGE} aks-flex-node
        ExecStop=/usr/bin/ctr --namespace aks-flex task kill --signal SIGTERM aks-flex-node
        Restart=always
        RestartSec=5s
        TimeoutStartSec=15min

        [Install]
        WantedBy=multi-user.target
