#!/bin/bash
# Bootstrap the node from the agent's container, as main's scripts/bootstrap.sh
# does on a host: render /etc/aks-flex-node/config.json, run preflight, and run
# start, which installs and starts the agent's unit. bootstrap.sh is in the
# image and runs the agent in it rather than downloading one.
#
# bootstrap.sh takes its inputs from AKS_FLEX_NODE_* variables, read here from
# /etc/aks-flex-node/bootstrap.env, one VARIABLE=value a line. Values aren't
# evaluated as shell. A base config with secrets, such as a bootstrap token,
# goes in a file of its own, named by AKS_FLEX_NODE_BASE_CONFIG_FILE. Reset
# removes both with the rest of /etc/aks-flex-node.
set -euo pipefail

inputs=/etc/aks-flex-node/bootstrap.env

if [[ ! -f $inputs ]]; then
    echo "aks-flex-node-bootstrap: no $inputs" >&2
    exit 1
fi
while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^AKS_FLEX_NODE_[A-Z0-9_]+= ]]; then
        export "${line?}"
    elif [[ -n ${line//[[:space:]]/} && $line != \#* ]]; then
        echo "aks-flex-node-bootstrap: ignoring a line of $inputs: ${line%%=*}" >&2
    fi
done <"$inputs"
exec /opt/aks-flex-node/bin/bootstrap.sh --use-installed-agent --install-dir /opt/aks-flex-node/bin "$@"
