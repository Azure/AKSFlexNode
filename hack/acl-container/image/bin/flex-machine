#!/bin/bash
# Manage systemd-nspawn machines on the host, from the agent container, with the
# host's machinectl and systemd-run (see host-exec).
#
# The machines belong to the host: their root filesystems are in
# /var/lib/machines, their settings in /etc/systemd/nspawn, and they run as
# systemd-nspawn@NAME.service in the host's machine.slice. Restarting or
# replacing the agent container leaves them running.
set -euo pipefail

HOST=${HOST_ROOT:-/host}
DEFAULT_IMAGE=${FLEX_MACHINE_IMAGE:-ghcr.io/azure/agent-azlinux3:v20260619}

usage() {
    cat <<EOF
usage: flex-machine COMMAND [ARGS...]

  list                       running machines, and the machine images on the host
  create NAME [--image REF] [--start]
                             unpack an OCI rootfs image into /var/lib/machines/NAME, and
                             write /etc/systemd/nspawn/NAME.nspawn
                             (default image: $DEFAULT_IMAGE)
  start NAME                 boot the machine and wait for it to run (machinectl start)
  stop NAME                  shut it down cleanly and wait for it to stop (machinectl poweroff)
  restart NAME               reboot it (machinectl reboot)
  terminate NAME             stop it at once, without a clean shutdown (machinectl terminate)
  status NAME                machinectl status
  shell NAME [CMD...]        a root shell in the machine, or CMD there (machinectl shell);
                             CMD needs an absolute path
  exec NAME CMD...           run CMD in the machine without a terminal, as the agent does
                             (systemd-run --machine --pipe --wait)
  logs NAME [-f]             the log of systemd-nspawn@NAME.service on the host
  enable NAME                start the machine at boot (machinectl enable)
  disable NAME               do not (machinectl disable)
  remove NAME                stop the machine, and delete its directory and .nspawn file
EOF
}

die() {
    echo "flex-machine: $*" >&2
    exit 1
}

need_name() {
    (( $# > 0 )) || die "a machine name is needed; see flex-machine help"
    [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || die "invalid machine name: $1"
}

# machined's state for the machine, such as running, or nothing if it is not
# running.
state() {
    machinectl show "$1" --property=State --value 2>/dev/null || true
}

wait_state() {
    local name=$1 want=$2 deadline=$((SECONDS + $3))
    while (( SECONDS < deadline )); do
        [[ $(state "$name") == "$want" ]] && return 0
        sleep 1
    done
    die "timed out waiting for $name to be ${want:-stopped}"
}

# The settings the AKS Flex Node agent writes for its machines (the unbounded
# library's nspawn.conf), less the per-machine bpffs and image archive mounts.
# Files in /etc/systemd/nspawn are trusted, so they override the
# systemd-nspawn@.service defaults, such as -U and --network-veth.
nspawn_settings() {
    cat <<'EOF'
# Written by flex-machine (hack/acl-container), after the settings the AKS Flex
# Node agent writes for its machines.
[Exec]
Capability=all
PrivateUsers=no
SystemCallFilter=@keyring bpf perf_event_open

[Network]
VirtualEthernet=no

[Files]
BindReadOnly=/lib/modules
EOF
}

cmd_create() {
    need_name "$@"
    local name=$1 image=$DEFAULT_IMAGE start=0
    shift
    while (( $# > 0 )); do
        case $1 in
            --image) image=${2:?--image needs a reference}; shift 2 ;;
            --start) start=1; shift ;;
            *) die "unknown option: $1" ;;
        esac
    done

    local dir=$HOST/var/lib/machines/$name
    [[ ! -e $dir ]] || die "/var/lib/machines/$name exists; remove it first"
    mkdir -p "$HOST/var/lib/machines" "$HOST/etc/systemd/nspawn"

    # Unpacked under a hidden name, which machinectl does not list, and renamed
    # once complete.
    local partial=$HOST/var/lib/machines/.$name.partial
    rm -rf "$partial"
    mkdir "$partial"
    echo "unpacking $image into /var/lib/machines/$name"
    if ! crane export --platform linux/amd64 "$image" - |
        tar -x -C "$partial" -p --numeric-owner --xattrs --xattrs-include='*'; then
        rm -rf "$partial"
        die "could not unpack $image"
    fi
    if [[ ! -e $partial/usr/lib/systemd/systemd && ! -e $partial/sbin/init ]]; then
        rm -rf "$partial"
        die "$image has no init, so systemd-nspawn cannot boot it"
    fi
    mv "$partial" "$dir"
    nspawn_settings >"$HOST/etc/systemd/nspawn/$name.nspawn"
    echo "created machine $name"
    if (( start )); then
        cmd_start "$name"
    fi
}

cmd_start() {
    need_name "$@"
    [[ -d $HOST/var/lib/machines/$1 ]] || die "no machine $1 in /var/lib/machines"
    machinectl start "$1"
    wait_state "$1" running 180
    echo "machine $1 is running"
}

cmd_stop() {
    need_name "$@"
    if [[ -z $(state "$1") ]]; then
        echo "machine $1 is not running"
        return
    fi
    machinectl poweroff "$1"
    wait_state "$1" "" 120
    echo "machine $1 stopped"
}

cmd_remove() {
    need_name "$@"
    local name=$1
    if [[ -n $(state "$name") ]]; then
        machinectl poweroff "$name" || true
        local deadline=$((SECONDS + 60))
        while [[ -n $(state "$name") ]] && (( SECONDS < deadline )); do
            sleep 1
        done
        if [[ -n $(state "$name") ]]; then
            machinectl terminate "$name" || true
            wait_state "$name" "" 30
        fi
    fi
    machinectl disable "$name" >/dev/null 2>&1 || true
    systemctl reset-failed "systemd-nspawn@$name.service" >/dev/null 2>&1 || true
    rm -rf "$HOST/var/lib/machines/$name" "$HOST/var/lib/machines/.$name.partial"
    rm -f "$HOST/etc/systemd/nspawn/$name.nspawn"
    echo "removed machine $name"
}

command=${1:-help}
(( $# > 0 )) && shift
case $command in
    list)
        machinectl list --no-pager
        echo
        machinectl list-images --no-pager
        ;;
    create) cmd_create "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) need_name "$@"; machinectl reboot "$1" ;;
    terminate) need_name "$@"; machinectl terminate "$1" ;;
    status) need_name "$@"; machinectl status --no-pager "$1" ;;
    shell)
        need_name "$@"
        name=$1
        shift
        if (( $# > 0 )); then
            machinectl --quiet shell "root@$name" "$@"
        else
            machinectl shell "root@$name"
        fi
        ;;
    exec)
        need_name "$@"
        name=$1
        shift
        (( $# > 0 )) || die "exec needs a command"
        systemd-run --machine="$name" --pipe --wait --quiet --collect -- "$@"
        ;;
    logs)
        need_name "$@"
        name=$1
        shift
        journalctl --no-pager -u "systemd-nspawn@$name.service" "$@"
        ;;
    enable) need_name "$@"; machinectl enable "$1" ;;
    disable) need_name "$@"; machinectl disable "$1" ;;
    remove) cmd_remove "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
