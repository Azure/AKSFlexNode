#!/bin/bash
# Run one of the host's tools against the host root, which the agent container
# mounts at /host.
#
# The image links machinectl, systemctl, systemd-run, and journalctl to this
# script, so those names run the host's binaries, with the host's libraries and
# configuration, rather than copies in the image that could disagree with the
# host's systemd. /host is a recursive bind of the host's /, so under chroot
# /run, with the D-Bus socket, is the host's, and so is /proc, since the
# container shares the host's PID namespace.
#
#   host-exec COMMAND [ARGS...]   run any host command
set -euo pipefail

host_root=${HOST_ROOT:-/host}
name=$(basename "$0")
if [[ $name == host-exec ]]; then
    if (( $# == 0 )); then
        echo "usage: host-exec COMMAND [ARGS...]" >&2
        exit 2
    fi
    name=$1
    shift
fi

if [[ ! -x $host_root/usr/bin/env ]]; then
    echo "host-exec: the host root is not mounted at $host_root" >&2
    exit 1
fi
exec chroot "$host_root" /usr/bin/env PATH=/usr/sbin:/usr/bin:/sbin:/bin "$name" "$@"
